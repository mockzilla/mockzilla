{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mockzilla Config Schema",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "description": "Application configuration.",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title displayed in the UI."
        },
        "port": {
          "type": "integer",
          "description": "Port number to listen on.",
          "default": 2200
        },
        "homeURL": {
          "type": "string",
          "description": "URL for the UI home page.",
          "default": "/"
        },
        "serviceURL": {
          "type": "string",
          "description": "URL for the service endpoints in the UI.",
          "default": "/.services"
        },
        "contextAreaPrefix": {
          "type": "string",
          "description": "Prefix for area-specific contexts.",
          "default": "in-"
        },
        "disableUI": {
          "type": "boolean",
          "description": "Disable the UI.",
          "default": false
        },
        "disableConfigUI": {
          "type": "boolean",
          "description": "Hide the Configuration tab in the UI.",
          "default": false
        },
        "history": {
          "type": "object",
          "description": "Request/response history configuration.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable history API and UI tab.",
              "default": true
            },
            "url": {
              "type": "string",
              "description": "URL prefix for history API endpoints.",
              "default": "/.history"
            },
            "duration": {
              "type": "string",
              "description": "Duration to keep request history (e.g., '60m', '2h'). A service's history.duration overrides it.",
              "default": "60m"
            }
          }
        },
        "replay": {
          "type": "object",
          "description": "Replay recording defaults and the Replay Explorer UI.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable the replay explorer API and UI tab.",
              "default": true
            },
            "url": {
              "type": "string",
              "description": "URL prefix for the replay explorer API.",
              "default": "/.replay"
            },
            "duration": {
              "type": "string",
              "description": "Default recording TTL (e.g., '24h'). A service's replay.duration overrides it.",
              "default": "24h"
            }
          }
        },
        "editor": {
          "type": "object",
          "description": "Editor configuration for the UI.",
          "properties": {
            "theme": {
              "type": "string",
              "description": "Editor theme.",
              "default": "chrome"
            },
            "fontSize": {
              "type": "integer",
              "description": "Editor font size.",
              "default": 16
            }
          }
        },
        "storage": {
          "type": "object",
          "description": "Shared storage for distributed features.",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["memory", "redis"],
              "description": "Storage type.",
              "default": "memory"
            },
            "redis": {
              "type": "object",
              "description": "Redis configuration (required when type is 'redis').",
              "properties": {
                "address": {
                  "type": "string",
                  "description": "Redis address (host:port)."
                },
                "password": {
                  "type": "string",
                  "description": "Redis password."
                },
                "db": {
                  "type": "integer",
                  "description": "Redis database number.",
                  "default": 0
                }
              }
            }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "description": "Map of service name to service configuration.",
      "additionalProperties": {
        "$ref": "#/$defs/serviceConfig"
      }
    }
  },
  "$defs": {
    "serviceConfig": {
      "type": "object",
      "description": "Service configuration.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Service name."
        },
        "history": {
          "type": "object",
          "description": "Request/response history recording configuration.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable history recording.",
              "default": true
            },
            "duration": {
              "type": "string",
              "description": "Time-to-live for history entries (e.g., '60m', '2h'). Overrides the app-level history.duration default.",
              "default": "60m"
            },
            "mask-headers": {
              "type": "array",
              "description": "Header name patterns to mask in history entries.",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "latency": {
          "type": "string",
          "description": "Fixed latency (e.g., '100ms')."
        },
        "latencies": {
          "type": "object",
          "description": "Percentile-based latencies (e.g., p50: 10ms, p99: 100ms).",
          "additionalProperties": {
            "type": "string"
          }
        },
        "errors": {
          "type": "object",
          "description": "Percentile-based error injection (e.g., p10: 500).",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "validate": {
          "type": "object",
          "properties": {
            "request": {
              "type": "boolean",
              "description": "Validate requests.",
              "default": true
            },
            "response": {
              "type": "boolean",
              "description": "Validate responses.",
              "default": false
            }
          }
        },
        "cache": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "boolean",
              "description": "Cache GET requests.",
              "default": true
            }
          }
        },
        "replay": {
          "type": "object",
          "description": "Replay (VCR-like) configuration: record API responses and replay them on subsequent requests matching specific request fields. Recording lifetime defaults to the app-level replay.duration.",
          "properties": {
            "duration": {
              "type": "string",
              "description": "Time-to-live for recordings (e.g., '24h', '1h30m'). Overrides the app-level replay.duration default.",
              "default": "24h"
            },
            "upstream-only": {
              "type": "boolean",
              "description": "Only record responses from upstream services.",
              "default": false
            },
            "auto-replay": {
              "type": "boolean",
              "description": "Activate replay for configured endpoints without requiring the X-Mockzilla-Replay header.",
              "default": false
            },
            "endpoints": {
              "type": "object",
              "description": "Map of path patterns to HTTP methods and their match configurations.",
              "additionalProperties": {
                "type": "object",
                "description": "HTTP methods for this path pattern.",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "match": {
                      "type": "object",
                      "description": "Request fields that form the replay key.",
                      "properties": {
                        "path": {
                          "type": "array",
                          "description": "Path variable names to include in the key.",
                          "items": { "type": "string" }
                        },
                        "body": {
                          "type": "array",
                          "description": "Request body fields (JSON dotted paths or form-encoded keys).",
                          "items": { "type": "string" }
                        },
                        "query": {
                          "type": "array",
                          "description": "Query-string parameters.",
                          "items": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "upstream": {
          "$ref": "#/$defs/upstreamConfig"
        },
        "endpoints": {
          "type": "object",
          "description": "Per-endpoint overrides keyed by path pattern, then HTTP method. Endpoint values fully replace the matching service-level setting (latency, errors, upstream).",
          "additionalProperties": {
            "type": "object",
            "description": "HTTP methods for this path pattern.",
            "additionalProperties": {
              "$ref": "#/$defs/endpointConfig"
            }
          }
        },
        "spec": {
          "type": "object",
          "description": "OpenAPI spec simplification options.",
          "properties": {
            "simplify": {
              "type": "boolean",
              "description": "Enable spec simplification.",
              "default": false
            },
            "optional-properties": {
              "type": "object",
              "description": "Controls how many optional properties to keep. When not set, all optional properties are kept.",
              "properties": {
                "min": {
                  "type": "integer",
                  "description": "Minimum number of optional properties to keep."
                },
                "max": {
                  "type": "integer",
                  "description": "Maximum number of optional properties to keep."
                }
              }
            }
          }
        },
        "mount": {
          "type": "string",
          "description": "URL prefix at which the service mounts (may contain `/`, e.g. `pets/v2`). Defaults to `/<service-name>` (the service folder name)."
        }
      }
    },
    "upstreamConfig": {
      "type": "object",
      "description": "Upstream proxy configuration.",
      "properties": {
        "url": {
          "type": "string",
          "description": "Upstream URL."
        },
        "timeout": {
          "type": "string",
          "description": "Request timeout duration (e.g., '5s').",
          "default": "5s"
        },
        "headers": {
          "type": "object",
          "description": "Headers to add to upstream requests.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "endpointConfig": {
      "type": "object",
      "description": "Per-endpoint override. Any field set here replaces the matching service-level setting for this path and method.",
      "properties": {
        "latency": {
          "type": "string",
          "description": "Fixed latency for this endpoint (e.g., '100ms')."
        },
        "latencies": {
          "type": "object",
          "description": "Percentile-based latencies for this endpoint.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "errors": {
          "type": "object",
          "description": "Percentile-based error injection for this endpoint.",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "upstream": {
          "$ref": "#/$defs/upstreamConfig",
          "description": "Upstream override for this endpoint only. Replaces (not merges with) the service-level upstream."
        }
      }
    }
  }
}
